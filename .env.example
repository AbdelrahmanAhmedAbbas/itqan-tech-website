# Public build switches. Rebuild after changes.
SITE_SHOW_CLIENT_NAMES=true
SITE_SHOW_WASFA=false
SITE_SHOW_EMAIL_FIELD=true
SITE_MDOS_STATUS=in-build
SITE_ANALYTICS_ENABLED=false
PLAUSIBLE_SCRIPT_URL=
# Local builds show owner placeholders by default.
# SITE_BUILD_TARGET=production

# Server-only. Never prefix secrets with VITE_.
SITE_URL=https://itqantech.org
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Enable only when the origin accepts requests exclusively through trusted Cloudflare.
TRUST_CLOUDFLARE_PROXY=false
