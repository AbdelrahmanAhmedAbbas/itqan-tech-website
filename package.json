{
  "name": "itqan-tech-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "preview": "node --env-file-if-exists=.env.local scripts/serve-built.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "assets": "node scripts/generate-assets.mjs",
    "audit:mobile": "node scripts/audit-mobile.mjs",
    "motion:generate": "node scripts/prepare-site.mjs && node scripts/prepare-captures.mjs && node scripts/generate-motion.mjs && node scripts/generate-posters.mjs",
    "capture:core": "node scripts/capture-core.mjs",
    "captures:prepare": "node scripts/prepare-captures.mjs",
    "capture:apps": "node scripts/capture-apps.mjs",
    "predev": "node scripts/prepare-site.mjs && node scripts/prepare-captures.mjs && node scripts/generate-motion.mjs && node scripts/generate-posters.mjs",
    "check:flags": "node scripts/check-build-flags.mjs"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@hyperframes/player": "0.8.226",
    "gsap": "3.14.2",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.8",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
